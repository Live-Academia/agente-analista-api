# Provider: "anthropic" ou "openai"
LLM_PROVIDER=anthropic

# Anthropic (se LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=sk-ant-api03-...
MODEL_NAME=claude-sonnet-4-5-20250514

# OpenAI (se LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-...
OPENAI_MODEL_NAME=gpt-4o

# Parametros gerais
MAX_TOKENS=4096
TEMPERATURE=0.3

# CORS — lista de origens permitidas separadas por virgula
ALLOWED_ORIGINS=http://localhost:3000,https://seu-app.fly.dev

# ── Google Sheets ──────────────────────────────────────────────────────────
# Metodo de autenticacao: "service_account" (padrao, recomendado) ou "oauth2"
GOOGLE_AUTH_METHOD=service_account

# Service Account — conteudo JSON do arquivo de chave do service account
GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}

# OAuth2 — JSON do authorized_user (alternativa ao Service Account)
# Obtenha com: gcloud auth application-default login --format=json
# GOOGLE_AUTH_METHOD=oauth2
# GOOGLE_AUTHORIZED_USER_JSON={"client_id":"...","client_secret":"...","refresh_token":"...","type":"authorized_user"}

# ── Supabase ───────────────────────────────────────────────────────────────
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_KEY=eyJ...

# ── BigQuery ───────────────────────────────────────────────────────────────
GCP_PROJECT_ID=my-project-id
# GOOGLE_APPLICATION_CREDENTIALS=./gcp-key.json

# ── Autenticacao ───────────────────────────────────────────────────────────
# Chave secreta para assinar tokens JWT (minimo 32 caracteres)
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
AUTH_SECRET_KEY=

# Chave para cookies do streamlit-authenticator (minimo 32 caracteres)
AUTH_COOKIE_KEY=

# YAML com credenciais de usuarios (senhas como bcrypt hash)
# Gere hash com: python scripts/create_user.py <senha>
# Nao commite este arquivo com credenciais reais — use Fly.io secrets em producao
AUTH_CONFIG_YAML=
# Exemplo de valor (com quebras de linha escapadas):
# AUTH_CONFIG_YAML="cookie:\n  expiry_days: 30\n  key: ${AUTH_COOKIE_KEY}\n  name: deep_agent_auth\ncredentials:\n  usernames:\n    admin:\n      email: admin@empresa.com\n      name: Administrador\n      password: $2b$12$HASH_AQUI\n      roles: [admin]\n    analista:\n      email: analista@empresa.com\n      name: Analista\n      password: $2b$12$HASH_AQUI\n      roles: [user]"
