# Provider: "anthropic" ou "openai"
LLM_PROVIDER=anthropic

# Anthropic (se LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=sk-ant-api03-...
MODEL_NAME=claude-sonnet-4-5-20250514

# OpenAI (se LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-...
OPENAI_MODEL_NAME=gpt-4o

# Parametros gerais
MAX_TOKENS=4096
TEMPERATURE=0.3

# CORS — lista de origens permitidas separadas por virgula
ALLOWED_ORIGINS=http://localhost:3000,https://seu-app.vercel.app

# Google Sheets (conteudo JSON do Service Account)
GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}

# Supabase
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_KEY=eyJ...

# BigQuery
GCP_PROJECT_ID=my-project-id
# GOOGLE_APPLICATION_CREDENTIALS=./gcp-key.json
